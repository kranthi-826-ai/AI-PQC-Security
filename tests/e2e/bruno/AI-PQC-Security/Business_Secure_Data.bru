meta {
  name: Business Secure Data
  type: http
  seq: 4
}

get {
  url: http://localhost:8080/api/v1/business/secure-data
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwtToken}}
}

tests {
  test("JWT grants business API access", function () {
    expect(res.status).to.equal(200);
    expect(res.body.username).to.equal("brunouser");
    expect(res.body.correlationId).to.be.a("string");
  });
}
